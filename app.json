{
  "expo": {
    "name": "나의 산길",
    "slug": "fathers-app",
    "scheme": "naisangil",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7FAF6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fathersapp.naisangil",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "추후 등산 중 위치 기록을 위해 위치 접근이 필요합니다. 1차 버전은 GPS를 사용하지 않습니다."
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
